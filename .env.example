# Django Configuration
DEBUG=False
SECRET_KEY=generate-a-secure-secret-key-for-production
ALLOWED_HOSTS=*
SITE_URL=https://your-app-name.up.railway.app
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app

# Database (Railway automatically provides DATABASE_URL when PostgreSQL service is linked)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Superuser Initial Setup (Optional: defaults to admin / admin123)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123

# Email Settings (Optional - falls back to console backend if password is not set)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Swiftbuy <your-email@gmail.com>
